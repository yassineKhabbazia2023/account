<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<AssemblyName>Pulse.Account.Core.Tests</AssemblyName>
		<RootNamespace>Pulse.Account.Core.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="MockedResponses\AccountDetailMocked.json" />
	  <None Remove="MockedResponses\AccountFavoriteMocked.json" />
	  <None Remove="MockedResponses\AccountListMocked.json" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="MockedResponses\AccountDetailMocked.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="MockedResponses\AccountFavoriteMocked.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="MockedResponses\AccountListMocked.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" Version="4.18.0" />
		<PackageReference Include="FluentAssertions" Version="6.12.0" />
		<PackageReference Include="Kpmg.ExceptionMiddleware" Version="1.47.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
		<PackageReference Include="Moq" Version="4.20.69" />
		<PackageReference Include="xunit" Version="2.4.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
		<PackageReference Include="coverlet.collector" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\src\Account.Core\Account.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\src\Account.Core\Account.Core.csproj" />
	  <ProjectReference Include="..\..\src\Account.Infrastructure\Account.Infrastructure.csproj" />
	</ItemGroup>

</Project>
