{
  "Serilog": {
    "Using": [ "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "Pulse.Back.Account",
      "Layer": "WebApi",
      "Domain": "account"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Error",
      "System": "Error"
    }
  },
  "Swagger": {
    "Version": "v1",
    "Title": "Account API",
    "RouteTemplate": "/account/api/{documentName}/api.{json|yaml}",
    "JsonEndpoint": "/account/api/v1/api.json",
    "licenseName": "Pulse France 2024",
    "UiEndpoint": "api",
    "ContactName": "Arab AIT OUARABI",
    "ContactEmail": "",
    "Description": ""
  },
  "AllowedHosts": "*",
  "ConfigCat": {
    "SdkKey": ""
  },
  "FeatureFlags": {
    "Defaults": {
      "isProspectExperienceEnabled": false,
      "isLastActivityFeatureEnabled": false
    }
  },
  "BrokerSetting": {
    "ServiceBusNamespace": "xxx",
    "ManagedIdentityClientId": "xxx",
    "PushTopicName": [ "account" ],
    "PullTopics": [
      {
        "TopicName": "contact",
        "Subscriptions": [ "contact-created-account", "contact-updated-account", "contact-removed-account" ]
      },
      {
        "TopicName": "registry",
        "Subscriptions": [ "registry-accountCreated-account", "registry-accountUpdated-account", "registry-accountRemoved-account", "registry-invoice-created-account", "registry-invoice-removed-account" ]
      },
      {
        "TopicName": "account",
        "Subscriptions": [ "role-created-account" ]
      },
      {
        "TopicName": "offer",
        "Subscriptions": [ "offer-validated-account" ]
      }
    ]
  },
  "EmailSettings": {
    "DelegationRequestEmailTemplate": "delegation-request-email-template",
    "DelegationRequestRefusedEmailTemplate": "delegation-request-refused-email-template",
    "SenderEmail": "noreply@rydge.fr",
    "ServiceBusTopic": "notif",
    "WalletBaseUrl": "https://app-itg01.itg.pulse.rydge.fr/collaborateur"
  }
}
