{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.ApplicationInsights"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "[your connection string here]",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Account API"
    }
  },
  "Swagger": {
    "Version": "v1",
    "Title": "Account API",
    "RouteTemplate": "/account/api/{documentName}/api.{json|yaml}",
    "JsonEndpoint": "/account/api/v1/api.json",
    "licenseName": "Pulse France 2024",
    "UiEndpoint": "api",
    "ContactName": "Arab AIT OUARABI",
    "ContactEmail": "",
    "Description": ""
  },
  "AllowedHosts": "*",
  "BrokerSetting": {
    "ServiceBusNamespace": "xxx",
    "ManagedIdentityClientId": "xxx",
    "PushTopicName": [ "account" ],
    "PullTopics": [
      {
        "TopicName": "contact",
        "Subscriptions": [ "contact-created-account", "contact-updated-account", "contact-removed-account" ]
      }
    ]
  }
}
